# Copia questo file in ".env" (stessa cartella) e inserisci i valori reali.
# Il file .env NON va committato.

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salone_auto
DB_USERNAME=postgres
DB_PASSWORD=

# ===== Email (SMTP) =====
# Esempio Gmail: host smtp.gmail.com, porta 587, password = "password per le app"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Mittente delle mail (se vuoto si usa MAIL_USERNAME)
MAIL_FROM=

# ===== JWT =====
# Almeno 32 caratteri (256 bit) per HS256. Generabile ad es. con:
#   openssl rand -base64 48
JWT_SECRET=
# Durata del token in millisecondi (86400000 = 24 ore)
JWT_EXPIRATION_MS=86400000

# ===== Frontend =====
# Origine ammessa dal CORS e base dei link nelle mail (reset password, disattiva avviso)
FRONTEND_URL=http://localhost:5173

# ===== Upload immagini =====
UPLOAD_DIR=uploads

# ===== Auto.dev (decodifica VIN per l'admin) =====
# Chiave da https://auto.dev (piano free: 1.000 chiamate/mese). Se vuota, la decodifica VIN risponde 502.
AUTODEV_API_KEY=

# ===== Amministratore iniziale =====
# Creato all'avvio se non esiste già un utente con questa email
ADMIN_EMAIL=
ADMIN_PASSWORD=
